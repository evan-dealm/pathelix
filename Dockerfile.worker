# ─── Dockerfile.worker — Workers BullMQ (VRP, PDF, ML, récurrences, rétention) ──
#
# Image légère : runtime Node.js + code source TS exécuté par tsx (pas de build Next.js).
# Une seule image pour les cinq workers ; docker-compose.yml choisit le process par service.

# Same runtime as the app image (Node 20 is end of life since April 2026).
ARG NODE_VERSION=24

# Stage 1: Dependencies
FROM node:${NODE_VERSION}-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
# postinstall (scripts/sync-maplibre-worker.js) must exist before `npm ci`.
COPY scripts ./scripts
RUN npm ci

# Stage 2: Build Prisma client
FROM node:${NODE_VERSION}-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY prisma ./prisma
# The client is generated here: src/generated is not in the repository, so a fresh clone has none.
COPY prisma.config.ts ./
ARG DATABASE_URL="postgresql://dummy:dummy@localhost:5432/dummy"
ENV DATABASE_URL=${DATABASE_URL}
RUN npx prisma generate

# Stage 3: Production
FROM node:${NODE_VERSION}-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/src/generated ./src/generated
COPY --from=builder /app/prisma ./prisma

# Code source (tsx l'exécute directement)
COPY src ./src
COPY scripts ./scripts
COPY tsconfig.json ./
COPY package.json ./

# tsx comes from the lockfile (node_modules/.bin), not from an unpinned global install.
ENV PATH=/app/node_modules/.bin:$PATH

# Le worker PDF tourne en bundle ESM (cf. pdfWorker.ts : @react-pdf chargé deux fois sinon).
RUN npm run build:worker:pdf
# Solver thread bundle used by the VRP worker (src/lib/vrp/solverPool.ts).
RUN npm run build:solver

RUN addgroup --system --gid 1001 worker && \
    adduser --system --uid 1001 --ingroup worker worker
USER worker

# Healthcheck défini par service dans docker-compose.yml (un process différent par worker).
# Process par défaut : le worker VRP.
CMD ["tsx", "src/workers/vrpWorker.ts"]
