# ─── Required ────────────────────────────────────────────────────────────────
DB_PASSWORD=change-me
DATABASE_URL=postgresql://pathelix:change-me@localhost:5432/pathelix_fleet
SESSION_SECRET=change-me-min-32-chars-random-string-here

# ─── App mode ─────────────────────────────────────────────────────────────────
USE_MOCK_DATA=false
FORCE_HTTPS=false
NODE_ENV=production

# ─── Database pool ────────────────────────────────────────────────────────────
# Number of PostgreSQL connections in the pool (default: 10)
DB_POOL_SIZE=10

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Full Redis URL (overrides REDIS_HOST/PORT if set)
REDIS_URL=
# Redis authentication
REDIS_USERNAME=
REDIS_PASSWORD=
# Redis database number (default: 0)
REDIS_DB=0
# Enable Redis TLS (true/false)
REDIS_TLS=false
# Set to true to disable Redis entirely and use in-memory fallback
REDIS_DISABLED=false

# ─── Auth ─────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=change-me
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=change-me
# Base URL for auth redirects (default: http://localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# ─── Nessy integration ────────────────────────────────────────────────────────
NESSY_BASE_URL=https://api.nessy.fr/v1
NESSY_API_KEY=
NESSY_WEBHOOK_SECRET=

# ─── Trimble routing ──────────────────────────────────────────────────────────
TRIMBLE_API_URL=https://maps.alk.com/api/latest
TRIMBLE_API_KEY=

# ─── External routing API (generic/trimble/here) ─────────────────────────────
# ROUTING_API_TYPE: trimble | here | generic (leave empty for Valhalla only)
ROUTING_API_TYPE=
ROUTING_API_KEY=
ROUTING_API_URL=
ROUTING_VEHICLE=truck
ROUTING_API_TIMEOUT_MS=3000
ROUTING_API_MAX_CHUNK=50

# ─── Valhalla routing engine ──────────────────────────────────────────────────
VALHALLA_URL=http://localhost:8002
# Fallback Valhalla instance (used if primary is down)
VALHALLA_FALLBACK_URL=
# Request timeout in ms (default: 5000)
VALHALLA_TIMEOUT_MS=5000
# Path to Valhalla traffic .tar file for real-time traffic
VALHALLA_TRAFFIC_TAR_PATH=

# ─── OSRM routing engine ──────────────────────────────────────────────────────
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT_MS=5000
OSRM_MAX_TABLE_SIZE=100

# ─── Map basemap (MapLibre GL JS) ──────────────────────────────────────────────
# Optional. Without it, maps use OpenFreeMap's free "liberty" style (no key needed).
# Get a free key at https://cloud.maptiler.com/account/keys/ to switch to MapTiler's
# vector style instead. Must be NEXT_PUBLIC_ so it's readable client-side (maps only
# ever render in the browser) — never put a non-public secret in this variable.
NEXT_PUBLIC_MAPTILER_KEY=

# ─── VRP engine ───────────────────────────────────────────────────────────────
VRP_CONCURRENCY=2
# Enable worker threads for VRP computation (true/false)
VRP_USE_THREADS=false
VRP_THREAD_CONCURRENCY=2
VRP_THREAD_TIMEOUT_MS=30000

# ─── AI Engine (Python OCR/ML service) ───────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
# Public URL for client-side access (optional)
NEXT_PUBLIC_AI_ENGINE_URL=
# HMAC secret for AI engine webhook callbacks (required if AI_ENGINE_URL is set)
AI_CALLBACK_SECRET=change-me-min-32-chars

# ─── LLM — Natural language mission parsing ───────────────────────────────────
# Claude API key (primary — set ANTHROPIC_API_KEY in environment, not here)
# Fallback: Ollama local LLM
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Bearer token for /api/metrics/prometheus endpoint (if absent, JWT session required)
METRICS_TOKEN=

# OpenTelemetry tracing
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Load shedding ────────────────────────────────────────────────────────────
# Max concurrent requests before load shedding kicks in
LOAD_MAX_CONCURRENT=100
# Request count above which throttling begins
LOAD_NORMAL_THRESHOLD=50
# Throttle delay in ms when under load
LOAD_THROTTLE_MS=500

# ─── SSE connections ──────────────────────────────────────────────────────────
# Max concurrent SSE connections per tenant. Code default (src/app/api/sse/driver-status/
# route.ts) is 200 — validated at the 150-driver load test (see docs/deploiement.md §3).
# This file previously said 50 (the original starting value before that test), which someone
# copying .env.example verbatim would have gotten instead of the validated 200 — corrected here
# 2026-09-22 (see docs/configuration.md for the full history of this discrepancy).
SSE_MAX_CONNECTIONS_PER_TENANT=200

# ─── Webhooks ─────────────────────────────────────────────────────────────────
# Bearer token for OBD webhook (required if OBD integration is enabled)
OBD_WEBHOOK_TOKEN=

# ─── Web Push VAPID keys (required for browser push notifications) ───────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ─── Traffic data ─────────────────────────────────────────────────────────────
# DATEX II URL for real-time traffic data (optional)
DATEX_II_URL=
# Path to urban centers JSON file for traffic zone detection
URBAN_CENTERS_JSON=

# ─── Grafana monitoring ───────────────────────────────────────────────────────
# Grafana admin password (default: pathelix_admin — change in production!)
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# ─── Debug ────────────────────────────────────────────────────────────────────
# Enable verbose debug logs in production (default: false)
DEBUG_LOGS=false

# Trackdéchets (BSDD) — HALT actif, appliqué en code (pas seulement en convention) dans
# src/lib/trackdechets/client.ts : ne jamais pointer vers l'URL de production
# (api.trackdechets.beta.gouv.fr) sans avoir suivi la procédure de validation manuelle
# documentée dans docs/deploiement.md §5. Le code retombe déjà sur le sandbox si cette
# variable est absente ; elle est explicitée ici pour que ce ne soit jamais un oubli.
TRACKDECHETS_API_URL=https://sandbox.trackdechets.beta.gouv.fr/
# Ne définir qu'après avoir suivi intégralement la checklist de docs/deploiement.md §5 —
# sans cette variable à "true", tout appel vers l'URL de production ci-dessus est bloqué
# au niveau du code, quelle que soit la valeur de TRACKDECHETS_API_URL.
TRACKDECHETS_HALT_LIFTED=
TRACKDECHETS_ENCRYPTION_KEY=   # 64 hex chars (32 bytes) — openssl rand -hex 32
TRACKDECHETS_WEBHOOK_SECRET=   # secret HMAC webhook Trackdéchets

# Chiffrement config intégrations (Geotab/Samsara…)
INTEGRATION_ENCRYPTION_KEY=    # 64 hex chars (32 bytes) — openssl rand -hex 32

# Rétention logs d'audit (jours, défaut 365)
AUDIT_RETENTION_DAYS=365
