{
  "name": "pathelix",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "node --max-old-space-size=8192 ./node_modules/next/dist/bin/next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "worker": "tsx src/workers/vrpWorker.ts",
    "worker:ml": "tsx src/workers/mlProfileWorker.ts",
    "worker:recurring": "tsx src/workers/recurringMissionsWorker.ts",
    "dev:fast": "next build && next start",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-massive": "npx tsx --expose-gc prisma/seed-massive.ts",
    "db:seed-superadmin": "npx tsx prisma/seed-superadmin.ts",
    "db:backfill-template-links": "npx tsx prisma/backfill-generatedFromTemplateId.ts",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.44.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/web-push": "^3.6.4",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.71.0",
    "exceljs": "^4.4.0",
    "fuse.js": "^7.1.0",
    "idb-keyval": "^6.2.2",
    "ioredis": "^5.10.0",
    "maplibre-gl": "^6.10.0",
    "next": "^15.5.18",
    "next-intl": "^4.8.3",
    "pg": "^8.20.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "rrule": "^2.8.1",
    "sharp": "^0.35.3",
    "swagger-ui-react": "^5.32.4",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zustand": "^4.5.2"
  },
  "overrides": {
    "hono": "^4.12.8",
    "@hono/node-server": "^1.19.11",
    "flatted": "^3.4.2",
    "lodash": "^4.17.22",
    "sharp": "^0.35.3",
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.3",
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.0.1",
    "dotenv": "^17.3.1",
    "eslint": "^8",
    "eslint-config-next": "15.5.18",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prisma": "^7.5.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  }
}
