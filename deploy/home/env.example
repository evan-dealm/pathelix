# Pathélix — personal server behind Cloudflare Tunnel (docker-compose.home.yml).
#
#   cp deploy/home/env.example .env.production && chmod 600 .env.production
#
# Every value below is a PLACEHOLDER. Generate each secret on the server with the command given
# next to it; never reuse a secret of another stack, never commit .env.production.
# `./deploy/home/ctl.sh check` refuses to go further while a placeholder is left.

# ─── Required secrets ─────────────────────────────────────────────────────────
# Hexadecimal only (they are placed in connection URLs): openssl rand -hex 24
DB_PASSWORD=change-me
REDIS_PASSWORD=change-me
# openssl rand -base64 48
SESSION_SECRET=change-me
# Exactly 64 hexadecimal characters: openssl rand -hex 32
# Encrypts integration secrets and the superadmin two-factor secret in the database: losing it
# makes them unreadable. Keep a copy with the backup passphrase, outside this server.
INTEGRATION_ENCRYPTION_KEY=change-me

# ─── Public address (read at BUILD time: a change needs `ctl.sh build`) ───────
NEXT_PUBLIC_SITE_URL=https://pathelix.com

# ─── Local port for the tunnel (loopback only) ────────────────────────────────
PATHELIX_PORT=3100
TZ=Europe/Paris

# ─── Sizes (defaults fit about 10 GB of free memory, see OPERATIONS.md §10) ──
# PG_MEMORY=1G
# PG_SHARED_BUFFERS=256MB
# REDIS_MEMORY=384M
# REDIS_MAXMEMORY=256mb
# APP_MEMORY=2G
# APP_HEAP_MB=1280
# WORKER_VRP_MEMORY=2G
# WORKER_VRP_CPUS=4
# VALHALLA_MEMORY=4G
# VALHALLA_THREADS=2
# VALHALLA_CPUS=4
# VRP_CONCURRENCY=1

# ─── Routing data (OpenStreetMap extract built by Valhalla on first start) ───
# VALHALLA_TILE_URLS=https://download.geofabrik.de/europe/france/rhone-alpes-latest.osm.pbf

# ─── Optional features ────────────────────────────────────────────────────────
# Outgoing e-mail (quotes, invoices, portal invitations). Without it nothing is e-mailed.
SMTP_URL=
MAIL_FROM=
DEMO_REQUEST_TO=
# Browser push notifications: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
# Error reporting. NEXT_PUBLIC_SENTRY_DSN is read at build time.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Prometheus scraping of /api/metrics/prometheus: openssl rand -hex 32
METRICS_TOKEN=
# Private hosts that admin-configured webhooks may call (empty = none, SSRF protection).
OUTBOUND_ALLOWED_HOSTS=

# ─── Tunnel as a container (only with `ctl.sh up --profile tunnel`) ───────────
# CLOUDFLARE_TUNNEL_TOKEN=

# ─── Backups (deploy/home/ctl.sh backup → scripts/backup-all.sh) ──────────────
BACKUP_DIR=/var/backups/pathelix
BACKUP_KEEP=7
# File holding the encryption passphrase (chmod 600), e.g. /etc/pathelix/backup.pass
BACKUP_PASSPHRASE_FILE=
# rclone destination outside this server, e.g. r2:pathelix-backups/home
BACKUP_RCLONE_REMOTE=
BACKUP_ALERT_URL=
BACKUP_HEARTBEAT_URL=
