// ─── Trackdéchets ─────────────────────────────────────────────────────────────

enum BsdStatus {
  DRAFT
  SEALED
  SENT
  RECEIVED
  PROCESSED
  REFUSED
  AWAITING_GROUP
  NO_TRACEABILITY
  CANCELED
  SIGNED_BY_PRODUCER
  SIGNED_BY_TRANSPORTER
  TEMP_STORED
  TEMP_STORER_ACCEPTED
  GROUPED
  RESEALED
  RESENT
  INITIAL
}

model TrackdechetsAccount {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  encryptedToken String
  iv             String
  keyVersion     Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Bsd {
  id         String    @id @default(cuid())
  tenantId   String
  tdId       String    @unique
  type       String    @default("BSDD")
  status     BsdStatus @default(DRAFT)
  missionId  String?
  readableId String    @default("")
  payload    Json
  errorMsg   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tdId])
  @@index([missionId])
}

// ─── Idempotence des actions chauffeur hors-ligne ────────────────────────────────
// Chaque action mise en file côté chauffeur (src/lib/syncQueue.ts) porte un UUID généré au
// moment de l'action, envoyé en en-tête Idempotency-Key. Une requête rejouée (double envoi
// réseau, ou double flush malgré la coordination Web Locks — voir syncQueue.ts) renvoie la
// réponse déjà enregistrée au lieu de retraiter/dupliquer l'action.
model IdempotencyKey {
  id         String   @id @default(cuid())
  tenantId   String
  key        String   // l'UUID généré côté client, jamais réutilisé pour une autre action
  route      String   // ex: "POST /api/driver-status/update" — diagnostic uniquement
  status     Int      // code HTTP de la réponse d'origine, rejoué tel quel
  response   Json     // corps de la réponse d'origine, rejoué tel quel
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([createdAt])
}
