// ─── Idempotence des actions chauffeur hors-ligne ────────────────────────────────
// Chaque action mise en file côté chauffeur (src/lib/syncQueue.ts) porte un UUID généré au
// moment de l'action, envoyé en en-tête Idempotency-Key. Une requête rejouée (double envoi
// réseau, ou double flush malgré la coordination Web Locks — voir syncQueue.ts) renvoie la
// réponse déjà enregistrée au lieu de retraiter/dupliquer l'action.
model IdempotencyKey {
  id         String   @id @default(cuid())
  tenantId   String
  key        String   // UUID généré côté client à la mise en file, jamais régénéré au retry
  route      String   // ex: "POST /api/driver-status/update" — une clé rejouée sur une autre route est refusée
  requestHash String  @default("") // SHA-256 du corps : même clé + corps différent = refus (422)
  // 0 = réservée (traitement en cours), sinon code HTTP de la réponse d'origine rejouée telle quelle
  status     Int      @default(0)
  response   Json?    // corps de la réponse d'origine, null tant que status = 0
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([createdAt])
}

/// Demo request left on the public website (/contact). Platform-level: it belongs to no tenant
/// and is read by the superadmin only. Purged after 3 years (src/app/api/demo-requests/route.ts).
model DemoRequest {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  company   String
  email     String
  phone     String    @default("")
  /// "" | 1-5 | 6-15 | 16-40 | 40+ (number of drivers)
  fleetSize String    @default("")
  message   String    @default("")
  createdAt DateTime  @default(now())
  /// Set when someone of the team has answered the prospect.
  handledAt DateTime?

  @@index([createdAt])
}
