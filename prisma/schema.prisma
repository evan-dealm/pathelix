generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                     String                 @id @default(cuid())
  name                   String
  slug                   String                 @unique
  plan                   TenantPlan             @default(FREE)
  trade                  String?
  // ─── Localisation & contact ─────────────────────────────────────────────
  timezone               String                 @default("Europe/Paris")
  locale                 String                 @default("fr-FR")
  contactEmail           String                 @default("")
  // ─── Limites du plan ────────────────────────────────────────────────────
  maxDrivers             Int?                   // null = illimité
  maxMissions            Int?                   // null = illimité
  // ─── Activité ───────────────────────────────────────────────────────────
  lastActiveAt           DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  suspendedAt            DateTime?
  suspendedBy            String?
  apiKeys                ApiKey[]
  auditLogs              AuditLog[]
  clients                Client[]
  drivers                Driver[]
  driverPositions        DriverPosition[]
  driverUnavailabilities DriverUnavailability[]
  exutoires              Exutoire[]
  fuelRecords            FuelRecord[]
  holidays               Holiday[]
  integrations           Integration[]
  interventionMetrics    InterventionMetric[]
  maintenanceRecords     MaintenanceRecord[]
  maintenancePlans       MaintenancePlan[]
  vehicleDefects         VehicleDefect[]
  missionComments        MissionComment[]
  mlProfiles             TenantMLProfile[]
  missions               Mission[]
  plans                  Plan[]
  sites                  Site[]
  siteProducts           SiteProduct[]
  settings               TenantSettings?
  history                TourHistory[]
  planningNotes          PlanningNote[]
  users                  User[]
  vehicles               Vehicle[]
  weeklyPlans            WeeklyPlan[]
  missionTemplates       MissionTemplate[]
  deliveryProofs         DeliveryProof[]
  pushSubscriptions      PushSubscription[]
  aiJobs                 AiJob[]
  trackdechetsAccount    TrackdechetsAccount?
  bsds                   Bsd[]
  idempotencyKeys        IdempotencyKey[]
  userPermissions        UserPermission[]
  materials              Material[]
  vehicleUnavailabilities VehicleUnavailability[]
  containerTypes         ContainerType[]
  containers             Container[]
  containerEvents        ContainerEvent[]
  clientContacts         ClientContact[]
  customerNotes          CustomerNote[]
  priceLists             PriceList[]
  priceRules             PriceRule[]
  documentSequences      DocumentSequence[]
  contracts              Contract[]
  quotes                 Quote[]
  quoteLines             QuoteLine[]
  orders                 Order[]
  orderLines             OrderLine[]
  invoices               Invoice[]
  invoiceLines           InvoiceLine[]
  payments               Payment[]
  weighings              Weighing[]
  documents              Document[]
  webhookEndpoints       WebhookEndpoint[]
  webhookDeliveries      WebhookDelivery[]
  notifications          Notification[]
  notificationPrefs      NotificationPreference[]
  portalUsers            PortalUser[]
  portalRequests         PortalRequest[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  // Globally unique (stored lowercase): login resolves the account — and therefore the tenant —
  // from the email alone, so two tenants can never hold the same address.
  email        String   @unique
  passwordHash String
  // Bumped on password change / role change / deletion — embedded in the session JWT as `sv` and
  // checked by the middleware, so revoking a user's access doesn't wait for the 24h expiry.
  sessionVersion Int    @default(0)
  role         UserRole @default(DRIVER)
  firstName    String   @default("")
  lastName     String   @default("")
  driverRef    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions  UserPermission[]

  @@index([tenantId])
}

model Driver {
  id               String    @id @default(cuid())
  tenantId         String
  firstName        String
  lastName         String
  sector           String
  depotName        String
  depotLat         Float
  depotLng         Float
  maxBinSizeM3     Float?
  vehicleCapacity  Int?
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  notes            String    @default("")
  phone            String    @default("")
  skills           Json      @default("[]")
  weeklyHoursMax   Float     @default(48)
  // ─── Informations RH ────────────────────────────────────────────────────
  email            String    @default("")
  employeeNumber   String    @default("")
  hiredAt          DateTime?
  birthDate        DateTime?
  licenseExpiry    DateTime?
  licenseCategories Json     @default("[]")   // ['B','C','CE',…]
  emergencyContact String    @default("")     // "Prénom Nom: 06 12 34 56 78"
  // ─── [4.C] Capacité multi-dimensionnelle ────────────────────────────────
  capacityDimensions Json     @default("{}")  // {volume?: number, nbBennes?: number} — poids supprimé (non lu par VRP, voir BACKLOG.md D1)
  // ─── Affichage ──────────────────────────────────────────────────────────
  color            String    @default("")     // couleur hex pour la carte
  startingExutoireId String?
  startingExutoire   Exutoire? @relation("DriverStartingExutoire", fields: [startingExutoireId], references: [id], onDelete: SetNull)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plans            Plan[]
  vehicles         Vehicle[]

  @@index([tenantId])
  @@index([tenantId, archived])
  @@index([tenantId, sector])
}

model Client {
  id              String        @id @default(cuid())
  tenantId        String
  name            String
  contact         String        @default("")
  phone           String        @default("")
  email           String        @default("")
  vip             Boolean       @default(false)
  requiresDeposit Boolean       @default(false)
  ecoResponsable  Boolean       @default(false)
  requiresBsd     Boolean       @default(false)
  voucherRequired Boolean       @default(false)
  notes           String        @default("")
  archived        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // ─── Informations commerciales ──────────────────────────────────────────
  siret           String        @default("")
  billingAddress  String        @default("")
  externalRef     String        @default("")   // référence ERP / logiciel tiers
  sector          String        @default("")   // zone géographique du client
  contractStart   DateTime?
  contractEnd     DateTime?
  paymentTermsDays Int          @default(30)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientSites     ClientSite[]
  missions        Mission[]
  siteProducts    SiteProduct[]
  containers      Container[]
  contacts        ClientContact[]
  notesTimeline   CustomerNote[]
  priceLists      PriceList[]
  contracts       Contract[]
  quotes          Quote[]
  orders          Order[]
  invoices        Invoice[]
  payments        Payment[]
  portalUsers     PortalUser[]
  portalRequests  PortalRequest[]

  @@index([tenantId])
  @@index([tenantId, archived])
  @@index([tenantId, name])
}

model Site {
  id                 String        @id @default(cuid())
  tenantId           String
  name               String
  address            String        @default("")
  latitude           Float         @default(0)
  longitude          Float         @default(0)
  accessNotes        String        @default("")
  defaultManeuverMin Int           @default(15)
  sector             String        @default("")
  archived           Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  // ─── Localisation détaillée ─────────────────────────────────────────────
  city               String        @default("")
  zipCode            String        @default("")
  country            String        @default("FR")
  siteType           String        @default("")    // 'chantier'|'entrepot'|'usine'|'bureau'|'autre'
  // ─── Horaires d'accès ───────────────────────────────────────────────────
  openingHoursOpen   Int?                          // minutes depuis minuit
  openingHoursClose  Int?
  clientSites        ClientSite[]
  missions           Mission[]
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteProducts       SiteProduct[]
  containers         Container[]
  quotes             Quote[]
  orders             Order[]

  @@index([tenantId])
  @@index([tenantId, archived])
  @@index([tenantId, name])
}

model ClientSite {
  id       String @id @default(cuid())
  clientId String
  siteId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([clientId, siteId])
  @@index([clientId])
  @@index([siteId])
}

model SiteProduct {
  id                 String    @id @default(cuid())
  tenantId           String
  siteId             String
  clientId           String
  wasteType          String
  binSizeLabel       String    @default("")
  binSizeM3          Float?
  equipmentType      String    @default("")
  defaultDurationMin Int       @default(30)
  defaultExutoireId  String?
  notes              String    @default("")
  archived           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  missions           Mission[]
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  defaultExutoire    Exutoire? @relation(fields: [defaultExutoireId], references: [id], onDelete: SetNull)
  site               Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([siteId, clientId])
  @@index([tenantId, archived])
}

model Mission {
  id                   String          @id @default(cuid())
  tenantId             String
  type                 MissionType
  date                 String
  address              String
  latitude             Float
  longitude            Float
  estimatedDurationMin Int
  maneuverTimeMin      Int             @default(0)
  clientName           String?
  outletName           String?
  wasteTypeLabel       String?
  binSize              String?
  binSizeM3            Float?
  accessNotes          String?
  priority             Int?
  timeWindowOpenMin    Int?
  timeWindowCloseMin   Int?
  linkedExutoireId     String?
  // Stable link to the MissionTemplate that generated this mission via
  // recurringMissionsWorker.ts, replacing the old tenantId+date+address+type+clientName dedup
  // heuristic. Null for manually-created missions and for missions generated before this field
  // existed that couldn't be unambiguously backfilled.
  generatedFromTemplateId String?
  archived             Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  attachments          Json            @default("[]")
  dependsOnId          String?
  notes                String          @default("")
  tags                 Json            @default("[]")
  clientId             String?
  equipmentType        String?
  productId            String?
  siteId               String?
  voucherDelivered     Boolean         @default(false)
  requiredSkills       Json            @default("[]")   // Compétences requises : ["permis_C","HAZMAT","grue"]
  needsGeocode         Boolean         @default(false)  // true = coords invalides au moment de l'import
  // ─── Résultats terrain (remplis par le chauffeur) ────────────────────────
  actualDurationMin    Float?          // durée réelle passée sur site
  actualDistanceKm     Float?          // distance réelle (GPS)
  completedAt          DateTime?       // horodatage de fin d'intervention
  cancelledAt          DateTime?
  cancelReason         String?
  driverComment        String          @default("")
  signatureUrl         String?         // signature client (URL image)
  externalRef          String?         // référence ERP / bon de travail
  // ─── [2.B] Tracking public ──────────────────────────────────────────────
  // Opaque random token (never a JWT) for the public page /track/[token], with its own expiry.
  trackingToken        String?         @unique
  trackingTokenExpiresAt DateTime?
  // ─── [2.E] Incidents ────────────────────────────────────────────────────
  incidentAt           DateTime?       // signalement incident
  incidentType         String?         // 'accident'|'panne'|'refus'|'acces'|'autre'
  incidentNotes        String          @default("")
  // ─── Poids (PTAC / charge utile) ─────────────────────────────────────────
  // Content weight of the bin, in kg — never invented: null = unknown. weightSource says where it
  // comes from; estimates (density × volume) carry their uncertainty, which planning adds on top.
  weightKg             Float?
  weightSource         String?         // 'WEIGHED' | 'DECLARED' | 'ESTIMATED'
  weightUncertaintyKg  Float?
  binTareKg            Float?          // empty bin weight, when known
  materialId           String?
  material             Material?       @relation(fields: [materialId], references: [id], onDelete: SetNull)
  // ─── Contenants ──────────────────────────────────────────────────────────
  // Bin type expected (POSER/ECHANGER), the bin put down and the bin taken away. Set when the
  // dispatcher reserves a bin or when the driver scans it; the container lifecycle follows the
  // mission's field statuses (pose → at customer, retrait → on the truck…).
  containerTypeId      String?
  placedContainerId    String?
  collectedContainerId String?
  containerType        ContainerType?  @relation(fields: [containerTypeId], references: [id], onDelete: SetNull)
  placedContainer      Container?      @relation("MissionPlacedContainer", fields: [placedContainerId], references: [id], onDelete: SetNull)
  collectedContainer   Container?      @relation("MissionCollectedContainer", fields: [collectedContainerId], references: [id], onDelete: SetNull)
  // ─── Commercial ──────────────────────────────────────────────────────────
  orderId              String?
  order                Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  dependsOn            Mission?        @relation("MissionDependency", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents           Mission[]       @relation("MissionDependency")
  client               Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  linkedExutoire       Exutoire?       @relation(fields: [linkedExutoireId], references: [id], onDelete: SetNull)
  product              SiteProduct?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  site                 Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generatedFromTemplate MissionTemplate? @relation(fields: [generatedFromTemplateId], references: [id], onDelete: SetNull)
  comments             MissionComment[]
  proof                DeliveryProof?
  bsds                 Bsd[]

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, archived])
  @@index([tenantId, date, archived])
  @@index([tenantId, priority])
  @@index([linkedExutoireId])
  @@index([clientId])
  @@index([siteId])
  @@index([tenantId, date, archived, priority])
  @@index([dependsOnId])
  @@index([generatedFromTemplateId])
  @@index([materialId])
  @@index([placedContainerId])
  @@index([collectedContainerId])
  @@index([orderId])
  @@index([tenantId, clientId, completedAt])
}

model MissionComment {
  id        String   @id @default(cuid())
  tenantId  String
  missionId String
  userId    String
  role      String   // 'admin' | 'dispatcher' | 'driver'
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, missionId])
  @@index([userId])
}

model Exutoire {
  id                 String        @id @default(cuid())
  tenantId           String
  name               String
  address            String
  lat                Float
  lng                Float
  openingHoursOpen   Int
  openingHoursClose  Int
  closedDays         Json          @default("[]")
  acceptedWasteTypes Json          @default("[]")
  serviceTimeMin     Int
  /// What the outlet charges per tonne dumped (€ HT) — a cost in profitability.
  feePerTonneEur     Float?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  missions           Mission[]
  siteProducts       SiteProduct[]
  driversStartingHere Driver[] @relation("DriverStartingExutoire")

  @@index([tenantId])
}

model Plan {
  id                   String    @id @default(cuid())
  tenantId             String
  driverId             String
  date                 String
  missions             Json
  statuses             Json      @default("{}")
  startTime            String    @default("07:00")
  speedKmh             Float     @default(50)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  locked               Boolean   @default(false)
  // ─── Métriques de tournée ────────────────────────────────────────────────
  estimatedDistanceKm  Float?    // distance totale estimée (km)
  estimatedDurationMin Int?      // durée totale estimée (minutes)
  actualDistanceKm     Float?    // distance réelle (GPS)
  actualDurationMin    Int?      // durée réelle mesurée
  departedAt           DateTime? // horodatage de départ du dépôt
  returnedAt           DateTime? // horodatage de retour au dépôt
  optimizationScore    Float?    // score qualité optimisation (0–100)
  driver               Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, driverId, date])
  @@index([tenantId, date])
  @@index([driverId])
}

model TourHistory {
  id        String   @id @default(cuid())
  tenantId  String
  date      String
  label     String   @default("")
  snapshot  String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
}

model PlanningNote {
  id        String   @id @default(cuid())
  tenantId  String
  date      String
  text      String   @default("")
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
}

model Vehicle {
  id               String              @id @default(cuid())
  tenantId         String
  licensePlate     String
  type             String
  brand            String              @default("")
  model            String              @default("")
  capacityM3       Float?
  maxBins          Int?
  mileageKm        Int                 @default(0)
  nextInspection   String?
  status           String              @default("active")
  notes            String              @default("")
  assignedDriverId String?
  archived         Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  // ─── Gabarit physique (pour routage Valhalla multi-profil) ───────────────
  gabaritProfile   String              @default("pl_26t")  // Clé du profil gabarit prédéfini
  weightTon        Float               @default(26)    // Poids total autorisé en charge (tonnes)
  heightM          Float               @default(4.0)   // Hauteur totale (mètres)
  widthM           Float               @default(2.55)  // Largeur totale (mètres)
  lengthM          Float               @default(12.0)  // Longueur totale (mètres)
  axleCount        Int                 @default(3)     // Nombre d'essieux
  hazmat           Boolean             @default(false) // Transport matières dangereuses
  // ─── Informations techniques ─────────────────────────────────────────────
  fuelType         String              @default("")    // 'diesel'|'essence'|'electrique'|'hybride'|'gpl'
  year             Int?                               // année de fabrication
  vin              String?                            // Vehicle Identification Number
  color            String              @default("")
  gpsDeviceId      String?                            // ID du traceur GPS
  // ─── Assurance & entretien ──────────────────────────────────────────────
  insuranceExpiry  String?                            // YYYY-MM-DD
  insuranceRef     String              @default("")
  lastServiceDate  String?                            // YYYY-MM-DD
  lastServiceKm    Int?                               // kilométrage au dernier entretien
  // ─── Péage / télépaiement ───────────────────────────────────────────────
  tollClass        Int                 @default(3)     // Classe péage (2, 3, 4)
  telepayBadge     String              @default("")    // Badge télépéage (tis_pl, axxes, eurotoll...)
  telepayDiscount  Float               @default(0)     // Réduction badge (%)
  // ─── Poids (contrainte PTAC de l'optimiseur) ─────────────────────────────
  // weightTon above is the PTAC (gross vehicle weight rating). Max load = min(payloadKg,
  // PTAC − tareKg); without tareKg nor payloadKg the truck has no weight limit in planning.
  tareKg           Int?                               // poids à vide équipé (kg)
  payloadKg        Int?                               // charge utile déclarée (kg)
  unavailabilities VehicleUnavailability[]
  assignedDriver   Driver?             @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fuelRecords      FuelRecord[]
  maintenanceRecords MaintenanceRecord[]
  maintenancePlans MaintenancePlan[]
  defects          VehicleDefect[]

  @@unique([tenantId, licensePlate])
  @@index([tenantId])
  @@index([tenantId, archived])
}

model MaintenanceRecord {
  id          String   @id @default(cuid())
  tenantId    String
  vehicleId   String
  type        String   // 'inspection'|'oil_change'|'repair'|'tire'|'other'
  description String   @default("")
  costEur     Float?
  mileageKm   Int?
  doneAt      String   // YYYY-MM-DD
  doneBy      String   @default("")
  notes       String   @default("")
  /// The preventive plan this intervention fulfils (its next due date/km restarts from here).
  planId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId, doneAt])
}

/// Preventive or regulatory maintenance of one truck: every N km and/or every N months, or a
/// fixed due date (insurance). Regulatory kinds (CT, TACHOGRAPH, INSURANCE) immobilise the truck
/// for planning once overdue.
model MaintenancePlan {
  id          String   @id @default(cuid())
  tenantId    String
  vehicleId   String
  /// SERVICE | CT | TACHOGRAPH | INSURANCE | TIRES | EXTINGUISHER | LIFTING | CUSTOM
  kind        String
  label       String
  everyKm     Int?
  everyMonths Int?
  lastDoneAt  String?  // YYYY-MM-DD
  lastDoneKm  Int?
  /// Explicit next due date (wins over the interval when set).
  dueDate     String?  // YYYY-MM-DD
  warnDays    Int      @default(30)
  warnKm      Int      @default(1500)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
}

/// A defect reported on a truck (driver walk-around check or office). A CRITICAL open defect
/// immobilises the truck until it is fixed or dismissed.
model VehicleDefect {
  id                  String    @id @default(cuid())
  tenantId            String
  vehicleId           String
  driverId            String?
  reportedBy          String
  /// MINOR | MAJOR | CRITICAL
  severity            String
  /// BRAKES | LIGHTS | TYRES | HYDRAULICS | LEAK | BODY | ENGINE | OTHER
  category            String    @default("OTHER")
  description         String
  mileageKm           Int?
  photoDocumentId     String?
  /// OPEN | IN_REPAIR | FIXED | DISMISSED
  status              String    @default("OPEN")
  resolution          String    @default("")
  resolvedAt          DateTime?
  resolvedBy          String?
  maintenanceRecordId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  vehicle             Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId, status])
  @@index([tenantId, status])
}

model FuelRecord {
  id            String   @id @default(cuid())
  tenantId      String
  vehicleId     String
  driverId      String?
  liters        Float
  costEur       Float
  pricePerLiter Float?
  mileageKm     Int      @default(0)
  stationName   String   @default("")
  filledAt      String   // YYYY-MM-DD
  fullTank      Boolean  @default(true)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([vehicleId, filledAt])
  @@index([tenantId, filledAt])
  @@index([driverId])
}

model DriverPosition {
  id         String   @id @default(cuid())
  tenantId   String
  driverId   String
  latitude   Float
  longitude  Float
  accuracy   Float?   // précision GPS en mètres
  speedKmh   Float?   // vitesse instantanée
  heading    Float?   // cap 0–360°
  recordedAt DateTime
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, driverId])
  @@index([tenantId, recordedAt])
  @@index([driverId, recordedAt(sort: Desc)])
  @@index([tenantId, driverId, recordedAt(sort: Desc)])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json     @default("{}")
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model Holiday {
  id        String   @id @default(cuid())
  tenantId  String
  date      String
  label     String
  recurring Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId])
}

model TenantSettings {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  defaultSpeedKmh       Float    @default(50)
  defaultStartTime      String   @default("07:00")
  maxWorkDayMin         Int      @default(600)
  pauseAfterMin         Int      @default(270)
  pauseDurationMin      Int      @default(45)
  costPerKm             Float    @default(0.35)
  fuelCostPerLiter      Float    @default(1.80)
  consumptionLPer100    Float    @default(30)
  /// Loaded hourly cost of a driver (wages + charges), € — null: labour is left out of
  /// profitability and the report says so.
  driverHourlyCostEur   Float?
  primaryColor          String   @default("#0055A4")
  logoUrl               String   @default("")
  companyDisplayName    String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  // ─── Localisation ───────────────────────────────────────────────────────
  timezone              String   @default("Europe/Paris")
  locale                String   @default("fr-FR")
  // ─── Notifications ──────────────────────────────────────────────────────
  notificationsEnabled  Boolean  @default(true)
  smsEnabled            Boolean  @default(false)
  emailEnabled          Boolean  @default(true)
  // ─── Facturation ────────────────────────────────────────────────────────
  invoicePrefix         String   @default("FAC")
  vatNumber             String   @default("")
  billingEmail          String   @default("")
  supportEmail          String   @default("")
  // ─── Quotas ─────────────────────────────────────────────────────────────
  maxOptimizationsPerDay Int     @default(10)
  // ─── [6.A] Feature flags par plan ────────────────────────────────────────
  features               Json    @default("{}")  // {gantt?: bool, recurring?: bool, incidents?: bool, webPush?: bool, pdf?: bool}
  // ─── [2.F] Formulaires d'intervention personnalisables ──────────────────
  interventionFormFields Json    @default("[]")  // Array<{key, label, type, required, options?}>
  // ─── Routage ─────────────────────────────────────────────────────────────
  /// Facteur correctif appliqué aux durées Valhalla/OSRM (free-flow → réel).
  /// Compensates pour le fait que Valhalla retourne des durées idéales sans
  /// congestion ni arrêts aux intersections. Calibré automatiquement via ML.
  /// Valeur initiale 1.28 ≈ 47km/h réel / 60km/h Valhalla.
  valhallaFactor        Float    @default(1.60)
  // ─── Pauses (CE 561/2006 + temps de travail) ─────────────────────────────
  // pauseAfterMin / pauseDurationMin / maxWorkDayMin above may only make the regulation stricter.
  lunchBreakEnabled     Boolean  @default(true)
  lunchBreakStart       String   @default("12:00")
  lunchBreakEnd         String   @default("13:30")
  lunchBreakDurationMin Int      @default(30)
  /// A wait of 15 min or more before a time window may be planned as a break (shown as such).
  breakDuringWait       Boolean  @default(true)
  // ─── Commercial ──────────────────────────────────────────────────────────
  defaultVatRate        Float    @default(20)
  quotePrefix           String   @default("DEV")
  orderPrefix           String   @default("CMD")
  creditNotePrefix      String   @default("AV")
  quoteValidityDays     Int      @default(30)
  defaultQuoteTerms     String   @default("")
  companyLegalName      String   @default("")
  companyAddress        String   @default("")
  companySiret          String   @default("")
  companyIban           String   @default("")
  /// Penalties and fixed recovery fee shown on invoices (Code de commerce L441-10).
  latePaymentTerms      String   @default("Pénalités de retard : 3 fois le taux d'intérêt légal. Indemnité forfaitaire pour frais de recouvrement : 40 €.")
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DriverUnavailability {
  id        String   @id @default(cuid())
  tenantId  String
  driverId  String
  startDate String
  endDate   String
  reason    String
  notes     String   @default("")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, driverId])
  @@index([tenantId, startDate, endDate])
}

/// Planned or ongoing immobilisation of a truck (maintenance, inspection, breakdown). The
/// optimiser never plans a driver on a day where all their trucks are unavailable.
model VehicleUnavailability {
  id        String   @id @default(cuid())
  tenantId  String
  vehicleId String
  startDate String   // YYYY-MM-DD inclusive
  endDate   String   // YYYY-MM-DD inclusive
  reason    String   // 'maintenance' | 'inspection' | 'breakdown' | 'other'
  notes     String   @default("")
  createdAt DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate, endDate])
  @@index([vehicleId])
}

/// A waste material (matière) — what is collected, its density for weight estimates and its
/// regulatory code. Mission.wasteTypeLabel keeps the free label; materialId links it when known.
model Material {
  id             String    @id @default(cuid())
  tenantId       String
  name           String
  /// European waste code (code déchet, e.g. "17 01 07"), used on BSDs.
  wasteCode      String    @default("")
  /// Bulk density (kg/m³) for weight estimates; null = no estimate is made.
  densityKgM3    Float?
  /// Typical fill ratio of a bin (0–1).
  fillFactor     Float     @default(0.8)
  /// Relative uncertainty of an estimate (0.25 = ±25 %), added to the planned weight.
  uncertaintyPct Float     @default(0.25)
  hazardous      Boolean   @default(false)
  archived       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  missions       Mission[]

  @@unique([tenantId, name])
  @@index([tenantId, archived])
}

enum ContainerStatus {
  AVAILABLE    // au dépôt, vide, utilisable
  RESERVED     // affectée à une pose planifiée
  IN_TRANSIT   // sur un camion
  AT_CUSTOMER  // posée chez un client
  FULL         // chez le client, signalée pleine
  TO_COLLECT   // chez le client, retrait demandé
  AT_EXUTOIRE  // laissée à l'exutoire
  MAINTENANCE  // en réparation
  IMMOBILIZED  // hors service (sinistre, litige…)
  LOST         // introuvable
  ARCHIVED     // sortie du parc
}

/// A kind of bin of the fleet (benne 15 m³, ampliroll 30 m³, multibenne 8 m³…).
model ContainerType {
  id               String      @id @default(cuid())
  tenantId         String
  name             String
  capacityM3       Float
  lengthM          Float?
  widthM           Float?
  heightM          Float?
  /// Empty weight (kg) — counted in the truck's load when the bin is full.
  tareKg           Float?
  /// Material names this type may carry (empty = any).
  allowedMaterials Json        @default("[]")
  /// Rental price per day (€ HT), default for quotes/invoices.
  dailyRentalPrice Float?
  purchaseCost     Float?
  archived         Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  containers       Container[]
  missions         Mission[]

  @@unique([tenantId, name])
  @@index([tenantId, archived])
}

/// One physical bin. Its status and location follow the missions that move it; manual changes
/// (maintenance, lost, …) are logged as events like everything else.
model Container {
  id              String          @id @default(cuid())
  tenantId        String
  /// Fleet number painted on the bin (e.g. B-00482), unique per tenant.
  number          String
  /// Random opaque token printed in the QR code — never the database id.
  qrToken         String          @unique
  typeId          String
  status          ContainerStatus @default(AVAILABLE)
  condition       String          @default("good")   // good | worn | damaged
  clientId        String?
  siteId          String?
  latitude        Float?
  longitude       Float?
  /// Free label of where it is when not at a customer ("Dépôt Nord", "Exutoire X").
  locationLabel   String          @default("")
  /// Driver holding it while IN_TRANSIT.
  driverId        String?
  /// Mission it is reserved for / being moved by.
  missionId       String?
  materialId      String?
  placedAt        DateTime?
  lastRotationAt  DateTime?
  lastMovementAt  DateTime?
  purchaseDate    String?
  purchaseCost    Float?
  notes           String          @default("")
  archived        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type            ContainerType   @relation(fields: [typeId], references: [id], onDelete: Restrict)
  client          Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  site            Site?           @relation(fields: [siteId], references: [id], onDelete: SetNull)
  events          ContainerEvent[]
  placedBy        Mission[]       @relation("MissionPlacedContainer")
  collectedBy     Mission[]       @relation("MissionCollectedContainer")

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, typeId, status])
  @@index([tenantId, clientId])
  @@index([tenantId, siteId])
}

/// History of a bin: every movement, status change, scan or note, with who/where/which mission.
model ContainerEvent {
  id          String           @id @default(cuid())
  tenantId    String
  containerId String
  /// CREATED | RESERVED | PLACED | PICKED_UP | EMPTIED | RETURNED | STATUS | SCANNED | NOTE
  type        String
  fromStatus  ContainerStatus?
  toStatus    ContainerStatus?
  missionId   String?
  clientId    String?
  siteId      String?
  driverId    String?
  userId      String?
  latitude    Float?
  longitude   Float?
  notes       String           @default("")
  at          DateTime         @default(now())
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  container   Container        @relation(fields: [containerId], references: [id], onDelete: Cascade)

  @@index([tenantId, containerId, at(sort: Desc)])
  @@index([tenantId, missionId])
  @@index([tenantId, clientId, at])
  @@index([tenantId, at])
}

// ─── Commercial : contacts, notes, tarifs, contrats, devis, commandes, factures ─────────────

/// A person at a customer: who to call, who receives quotes/invoices, who uses the portal.
model ClientContact {
  id               String   @id @default(cuid())
  tenantId         String
  clientId         String
  name             String
  role             String   @default("")
  email            String   @default("")
  phone            String   @default("")
  isPrimary        Boolean  @default(false)
  receivesInvoices Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client           Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
}

/// Customer timeline entry written by a person (call, email, meeting, note).
model CustomerNote {
  id        String   @id @default(cuid())
  tenantId  String
  clientId  String
  kind      String   @default("NOTE") // NOTE | CALL | EMAIL | MEETING
  content   String
  createdBy String
  at        DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId, at])
}

/// A price grid: the tenant's default one, or one negotiated for a customer (or a contract).
model PriceList {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  isDefault  Boolean     @default(false)
  clientId   String?
  validFrom  String?     // YYYY-MM-DD
  validTo    String?
  archived   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client     Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  rules      PriceRule[]
  contracts  Contract[]

  @@index([tenantId, clientId])
}

/// One priced item of a grid. The pricing engine (src/lib/pricing) picks the most specific rule
/// for an operation (conditions on bin type, material, mission type, zone) and explains it.
model PriceRule {
  id          String    @id @default(cuid())
  tenantId    String
  priceListId String
  /// TRANSPORT | KM | ZONE | POSE | RETRAIT | ECHANGE | ROTATION | ALLER_RETOUR | RENTAL_DAY | TREATMENT_TON
  /// | EXUTOIRE | FUEL_PCT | URGENCY_PCT | WEEKEND_PCT | DISCOUNT_PCT | MINIMUM | CUSTOM
  code        String
  label       String
  /// UNIT | KM | DAY | TON | PCT | FLAT
  unit        String    @default("UNIT")
  amount      Float
  vatRate     Float     @default(20)
  /// { containerTypeId?, materialId?, missionType?, zipPrefix?, freeDays?, minQty? }
  conditions  Json      @default("{}")
  priority    Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@index([tenantId, priceListId])
}

/// Atomic per-tenant, per-year numbering (quotes, orders, invoices, credit notes). Invoice
/// numbers are taken when the invoice is issued, so the sequence has no gap.
model DocumentSequence {
  id       String @id @default(cuid())
  tenantId String
  kind     String // QUOTE | ORDER | INVOICE | CREDIT_NOTE | CONTRACT
  year     Int
  next     Int    @default(1)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, year])
}

model Contract {
  id                String     @id @default(cuid())
  tenantId          String
  number            String
  clientId          String
  siteId            String?
  priceListId       String?
  status            String     @default("ACTIVE") // DRAFT | ACTIVE | SUSPENDED | ENDED
  title             String     @default("")
  startDate         String
  endDate           String?
  /// NONE | TACIT (tacit renewal for the same duration)
  renewal           String     @default("NONE")
  noticeDays        Int        @default(30)
  /// PER_OPERATION | MONTHLY
  billingFrequency  String     @default("PER_OPERATION")
  rentalFreeDays    Int        @default(0)
  paymentTermsDays  Int        @default(30)
  notes             String     @default("")
  createdBy         String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  priceList         PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  orders            Order[]
  invoices          Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, clientId])
  @@index([tenantId, status, endDate])
}

model Quote {
  id             String      @id @default(cuid())
  tenantId       String
  number         String
  clientId       String
  siteId         String?
  /// DRAFT | SENT | ACCEPTED | REFUSED | EXPIRED | CONVERTED
  status         String      @default("DRAFT")
  title          String      @default("")
  issueDate      String
  validUntil     String
  notes          String      @default("")
  terms          String      @default("")
  totalHT        Float       @default(0)
  totalVAT       Float       @default(0)
  totalTTC       Float       @default(0)
  sentAt         DateTime?
  decidedAt      DateTime?
  decidedBy      String      @default("")
  refusalReason  String      @default("")
  orderId        String?     @unique
  createdBy      String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client         Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site           Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  order          Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  lines          QuoteLine[]

  @@unique([tenantId, number])
  @@index([tenantId, clientId])
  @@index([tenantId, status, validUntil])
}

/// A line of a quote or order. Operational lines (missionType set) become missions on conversion.
model QuoteLine {
  id              String  @id @default(cuid())
  tenantId        String
  quoteId         String
  position        Int
  label           String
  description     String  @default("")
  quantity        Float   @default(1)
  unit            String  @default("UNIT")
  unitPrice       Float   @default(0)
  discountPct     Float   @default(0)
  vatRate         Float   @default(20)
  amountHT        Float   @default(0)
  /// How the price was obtained (grid, rule, manual) — shown to the user.
  explanation     String  @default("")
  missionType     String?
  containerTypeId String?
  materialId      String?
  /// For rentals / rotations: planned date of the operation (YYYY-MM-DD).
  plannedDate     String?
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote           Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId, quoteId])
}

model Order {
  id          String      @id @default(cuid())
  tenantId    String
  number      String
  clientId    String
  siteId      String?
  contractId  String?
  /// CONFIRMED | IN_PROGRESS | COMPLETED | CANCELLED
  status      String      @default("CONFIRMED")
  /// ONE_OFF | POSE_RETRAIT | ROTATION | RECURRING | LONG_RENTAL
  kind        String      @default("ONE_OFF")
  title       String      @default("")
  startDate   String
  endDate     String?
  notes       String      @default("")
  totalHT     Float       @default(0)
  createdBy   String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  site        Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  contract    Contract?   @relation(fields: [contractId], references: [id], onDelete: SetNull)
  quote       Quote?
  lines       OrderLine[]
  missions    Mission[]
  invoices    Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, clientId])
  @@index([tenantId, status])
}

model OrderLine {
  id              String  @id @default(cuid())
  tenantId        String
  orderId         String
  position        Int
  label           String
  description     String  @default("")
  quantity        Float   @default(1)
  unit            String  @default("UNIT")
  unitPrice       Float   @default(0)
  discountPct     Float   @default(0)
  vatRate         Float   @default(20)
  amountHT        Float   @default(0)
  explanation     String  @default("")
  missionType     String?
  containerTypeId String?
  materialId      String?
  plannedDate     String?
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
}

model Invoice {
  id                String        @id @default(cuid())
  tenantId          String
  /// Taken at issue time (gap-free); null while DRAFT.
  number            String?
  /// INVOICE | CREDIT_NOTE
  kind              String        @default("INVOICE")
  creditedInvoiceId String?
  clientId          String
  orderId           String?
  contractId        String?
  /// DRAFT | ISSUED | SENT | PARTIALLY_PAID | PAID | CANCELLED  (overdue = computed from dueDate)
  status            String        @default("DRAFT")
  issueDate         String?
  dueDate           String?
  periodStart       String?
  periodEnd         String?
  /// Snapshot of the customer's legal details at issue time.
  clientName        String        @default("")
  billingAddress    String        @default("")
  clientSiret       String        @default("")
  totalHT           Float         @default(0)
  totalVAT          Float         @default(0)
  totalTTC          Float         @default(0)
  amountPaid        Float         @default(0)
  /// Total (TTC, positive) of the credit notes issued against this invoice — what is due is totalTTC − creditedTTC − amountPaid.
  creditedTTC       Float         @default(0)
  notes             String        @default("")
  sentAt            DateTime?
  paidAt            DateTime?
  cancelledAt       DateTime?
  exportedAt        DateTime?
  createdBy         String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  order             Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  contract          Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  creditedInvoice   Invoice?      @relation("CreditNote", fields: [creditedInvoiceId], references: [id], onDelete: SetNull)
  creditNotes       Invoice[]     @relation("CreditNote")
  lines             InvoiceLine[]
  payments          Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, clientId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, issueDate])
}

model InvoiceLine {
  id           String   @id @default(cuid())
  tenantId     String
  invoiceId    String
  position     Int
  label        String
  description  String   @default("")
  quantity     Float    @default(1)
  unit         String   @default("UNIT")
  unitPrice    Float    @default(0)
  discountPct  Float    @default(0)
  vatRate      Float    @default(20)
  amountHT     Float    @default(0)
  explanation  String   @default("")
  /// Field data this line bills (traceability: mission, bin, weighing).
  missionId    String?
  containerId  String?
  weighingId   String?
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([tenantId, missionId])
}

model Payment {
  id          String   @id @default(cuid())
  tenantId    String
  clientId    String
  /// Null = received but not yet matched to an invoice.
  invoiceId   String?
  amount      Float
  /// TRANSFER | CHECK | CARD | CASH | DIRECT_DEBIT | OTHER
  method      String   @default("TRANSFER")
  reference   String   @default("")
  receivedAt  String   // YYYY-MM-DD
  notes       String   @default("")
  provider    String?
  providerRef String?
  createdBy   String
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId, clientId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, receivedAt])
}

/// A weighing ticket: from the driver, an OCR reading (to be confirmed by a person) or an import.
model Weighing {
  id           String    @id @default(cuid())
  tenantId     String
  missionId    String?
  /// Plan step it was recorded on (a dump step id, synthetic).
  stepId       String?
  driverId     String?
  exutoireId   String?
  containerId  String?
  materialId   String?
  clientId     String?
  ticketNumber String    @default("")
  grossKg      Float?
  tareKg       Float?
  netKg        Float
  /// MANUAL | DRIVER | OCR | IMPORT
  source       String    @default("MANUAL")
  /// PENDING_REVIEW | VALIDATED | REJECTED — OCR readings wait for a person.
  status       String    @default("VALIDATED")
  aiJobId      String?
  documentId   String?
  weighedAt    DateTime  @default(now())
  validatedBy  String?
  validatedAt  DateTime?
  notes        String    @default("")
  createdAt    DateTime  @default(now())
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, missionId])
  @@index([tenantId, status])
  @@index([tenantId, clientId, weighedAt])
  @@index([tenantId, weighedAt])
}

/// A stored file and what it belongs to. Bytes live in the storage backend (local disk or
/// S3-compatible, src/lib/storage), never under public/.
model Document {
  id              String   @id @default(cuid())
  tenantId        String
  /// QUOTE_PDF | INVOICE_PDF | CREDIT_NOTE_PDF | CONTRACT | WEIGHING_TICKET | PHOTO | SIGNATURE | BSD | PROOF | REPORT | OTHER
  kind            String
  storageKey      String
  filename        String
  mimeType        String
  sizeBytes       Int
  sha256          String
  clientId        String?
  missionId       String?
  quoteId         String?
  orderId         String?
  invoiceId       String?
  contractId      String?
  weighingId      String?
  containerId     String?
  /// Shown in the customer portal.
  visibleToClient Boolean  @default(false)
  createdBy       String
  createdAt       DateTime @default(now())
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, storageKey])
  @@index([tenantId, clientId])
  @@index([tenantId, missionId])
  @@index([tenantId, invoiceId])
  @@index([tenantId, quoteId])
}

/// A subscriber to business events (ERP, BI, customer system). Secret stored encrypted.
model WebhookEndpoint {
  id              String            @id @default(cuid())
  tenantId        String
  url             String
  description     String            @default("")
  /// Encrypted { secret } (src/lib/configCrypto.ts) — signing key of the deliveries.
  secret          Json
  /// Event names subscribed to; empty = all.
  events          Json              @default("[]")
  active          Boolean           @default(true)
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  consecutiveFailures Int           @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([tenantId, active])
}

/// One event for one endpoint: retried with exponential backoff, then DEAD (replayable by hand).
model WebhookDelivery {
  id             String          @id @default(cuid())
  tenantId       String
  endpointId     String
  /// Stable id of the event, sent as Pathelix-Event-Id — consumers deduplicate on it.
  eventId        String
  eventType      String
  payload        Json
  /// PENDING | SUCCESS | FAILED (will retry) | DEAD (retries exhausted)
  status         String          @default("PENDING")
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, endpointId, createdAt(sort: Desc)])
  @@index([status, nextAttemptAt])
  @@index([eventId])
}

/// One notification for one staff user (fan-out at creation, so read state is per person).
model Notification {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  /// P1_CREATED | UNASSIGNED | DRIVER_ABSENT | VEHICLE_DOWN | CONTAINER_LONG_STAY | CONTRACT_ENDING
  /// | QUOTE_EXPIRING | INVOICE_OVERDUE | WEBHOOK_FAILING | PORTAL_REQUEST | WEIGHING_REVIEW | INCIDENT
  kind       String
  /// info | warning | critical
  severity   String    @default("info")
  title      String
  body       String    @default("")
  /// Admin tab (and optional entity) to open.
  link       String    @default("")
  entityType String?
  entityId   String?
  /// Same key within 24 h = same notification (anti-spam).
  dedupeKey  String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt, createdAt(sort: Desc)])
  @@index([tenantId, userId, dedupeKey, createdAt])
}

/// Per user and kind: which channels to use (in-app is always on for critical).
model NotificationPreference {
  id        String  @id @default(cuid())
  tenantId  String
  userId    String
  kind      String
  inApp     Boolean @default(true)
  email     Boolean @default(false)
  push      Boolean @default(false)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, kind])
}

/// A person of a customer who signs in to the customer portal (never to the admin). Sees only
/// their own company's data; invited by the haulier, sets their own password.
model PortalUser {
  id              String    @id @default(cuid())
  tenantId        String
  clientId        String
  /// Lowercase, unique across the platform (login resolves the account from it).
  email           String    @unique
  name            String    @default("")
  passwordHash    String?
  /// SHA-256 of the one-time invitation / reset token.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  sessionVersion  Int       @default(0)
  disabled        Boolean   @default(false)
  lastLoginAt     DateTime?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, clientId])
}

/// A request made by a customer from the portal (rotation, pickup, extra bin, problem).
model PortalRequest {
  id            String    @id @default(cuid())
  tenantId      String
  clientId      String
  siteId        String?
  portalUserId  String
  /// ROTATION | PICKUP | NEW_CONTAINER | ISSUE | OTHER
  kind          String
  containerId   String?
  preferredDate String?
  message       String    @default("")
  /// NEW | ACCEPTED | DONE | REJECTED
  status        String    @default("NEW")
  missionId     String?
  response      String    @default("")
  handledBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, createdAt])
  @@index([tenantId, clientId])
}

model UserPermission {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  /// * Permission key : 'optimize', 'manage_drivers', 'manage_exutoires', 'manage_missions',
  ///       'manage_vehicles', 'manage_users', 'view_reports', 'view_costs', 'manage_settings',
  ///       'api_access', 'manage_integrations'
  permission String
